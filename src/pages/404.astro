---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Colorteam" description="This page doesn't exist." page="page-404">
  <section class="section ct-art-head" style="min-height:70vh;display:flex;align-items:center">
    <div class="container w-layout-blockcontainer"><div class="ct-art-headwrap">
      <div class="ct-art-tags"><span class="ct-chip">404</span></div>
      <h1 class="ct-art-title">This page took a different route</h1>
      <p class="ct-art-dek">The link may be old or mistyped. Try the home page, our work or the latest insights.</p>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap">
        <a class="ct-sp-follow" style="background:var(--primary-color);color:#000" href="/">Go to the home page</a>
        <a class="ct-sp-follow" style="background:#161616;color:#DEDCD0" href="/work/">See our work</a>
      </div>
    </div></div>
  </section>
</Base>
