---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import data from "../../data/articles.json";
const featured = data.articles.find((a) => a.slug === data.featured) ?? data.articles[0];
const f = featured.feature ?? { title: featured.title, dek: featured.card, readTime: "", stats: [], cta: "Read the article" };
---
<Base title="Insights | Colorteam" description="Case studies and thinking from Colorteam on brand, content and go-to-market." image="/img/cover-neclive-v2.webp" page="page-blog" navCurrent="/blog/">
<div class="ct-page" id="page-blog"><section class="section hero podcast-hero blog-hero" id="blog-top"><div aria-hidden="true" class="ct-hero-bg"><div class="ct-glow g"></div><div class="ct-glow p"></div><div class="ct-glow w"></div><div class="ct-grid"></div><div class="ct-noise"></div></div><div class="container w-layout-blockcontainer"><div class="hero-wrapper"><div class="inner-top-wrap"><a class="sub-title-wrap ct-pill-link" href="#blog-featured"><div class="new-text">Insights</div><div class="inner-sub-title">Our latest thinking</div><img alt="" class="inner-icon" src="/img/icons/arrow-right-lime.svg"/></a><h2 class="inner-title">Insights</h2><p class="inner-details">How we think about brand, content and go-to-market, told through real projects and the numbers behind them.</p><div class="inner-button-wrap"></div></div></div></div></section><section class="section ct-feature" id="blog-featured">
<div class="container w-layout-blockcontainer">
<a class="ct-feature-card" href={`/blog/${featured.slug}/`}>
<img alt={featured.title} class="ct-feature-img" loading="lazy" src={featured.cover}/>
<div class="ct-feature-body">
<div class="ct-feature-meta"><span class="ct-chip">Featured</span><span class="ct-chip is-ghost">{featured.category}</span>{f.readTime && <span class="ct-feature-read">{f.readTime}</span>}</div>
<h2 class="ct-feature-title">{f.title}</h2>
<p class="ct-feature-dek">{f.dek}</p>
{f.stats && f.stats.length > 0 && <div class="ct-feature-stats">{f.stats.map((st) => <div><b>{st.label}</b><span>{st.text}</span></div>)}</div>}
<span class="ct-feature-cta">{f.cta || "Read the article"} <svg aria-hidden="true" fill="none" height="18" viewbox="0 0 24 24" width="18"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"></path></svg></span>
</div>
</a>
</div>
</section><section class="section blog-v1 ct-blog-all" id="blog-all"><div class="container w-layout-blockcontainer"><div class="blog-v1-wrapper"><div class="future-top-wrap"><div class="feature-top-left-wrap"><h2 class="future-title _01">All Articles</h2></div></div><div class="blog-v1-wrap"><div class="blog-cl-wrapper"><div class="blog-v1-grid-wrap" role="list">{data.articles.map((a) => <ArticleCard article={a} />)}</div></div></div></div></div></section></div>
</Base>
